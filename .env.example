# ---- App ----
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string   # JWT signing key; `openssl rand -hex 32`
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# ---- Data stores ----
DATABASE_URL=postgresql+asyncpg://jobhunt:jobhunt@localhost:5432/jobhunt
REDIS_URL=redis://localhost:6379/0

# ---- LLM providers ----
# Which chat provider to use for extraction, judging and writing: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                     # required for embeddings even when LLM_PROVIDER=anthropic

# Model routing. Cheap model for extraction, strong model for judging and writing.
# Anthropic defaults below; OpenAI equivalents are configured the same way.
MODEL_EXTRACT=claude-haiku-5-5
MODEL_JUDGE=claude-opus-5-5
MODEL_WRITE=claude-opus-5-5
# openai (needs OPENAI_API_KEY) | hash (offline, demo quality; for development without keys)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Observability (optional; tracing is a no-op when unset) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Email digest (optional; logs to stdout when SMTP_HOST is empty) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=jobhunt@example.com
SMTP_USE_TLS=true

# ---- Job sources ----
# Comma-separated Greenhouse / Lever board slugs, e.g. "stripe,gitlab"
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
